// device_read — a reading loop for an LPS22HB or LPS22HH on a breakout, for
// an nRF52840 DK or an nRF54LM20 DK.
//
// The breakout's SDA and SCL go to the board's I2C pins and its CS pin to
// the supply, which selects I2C; its SDO/SA0 pin goes to ground or is left
// to its pull-down, which puts the part at 0x5C.  The program waits for
// the part to start, reads WHO_AM_I and takes the register map from it
// (0xB1 an LPS22HB, 0xB3 an LPS22HH), brings the part up with block data
// update and the part powered down, and four times a second starts one
// conversion, waits for it to finish and prints one line over RTT:
//
//     lps22 mC=<millidegrees> mPa=<millipascals>
//
// At sea level the pressure is about 101 325 000 millipascals.
//
// Build it with `novo build --target=nrf52840-dk tests/device_read.nv` or
// `novo build --target=nrf54lm20-dk tests/device_read.nv`.

use embedded_hal.{ BoardI2c, BoardGpio }
use dev_bus
use lps22hb
use lps22hb.{ Lps22 }

// The part's address with the SDO/SA0 pin low or open.
const ADDR = 0x5C

// A label and a number, written without building a string.
fn field(label: Str, v: Int) [hw]
    hal.uart.write(label)
    hal.uart.write(str.from_int(v))

@tier(embedded)
fn main() [hw]
    var part = Lps22.attach(BoardI2c { id: 0 }, BoardGpio { id: 0 }, dev_bus.wiring_i2c(0, ADDR))
    hal.timer.delay_ms(10)
    if not part.begin()
        hal.uart.write("lps22: no answer\n")
        return
    loop
        match part.sample_once(4000)
            Some(s) =>
                hal.uart.write("lps22")
                field(" mC=", s.milli_c)
                field(" mPa=", s.milli_pa)
                hal.uart.write("\n")
            None    =>
                hal.uart.write("lps22: no result\n")
        hal.timer.delay_ms(250)
